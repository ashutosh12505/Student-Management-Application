pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend Build') {
            steps {
                dir('student-management-backend') {
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        // stage('Backend Test') {
        //     steps {
        //         dir('student-management-backend') {
        //             sh './mvnw test'
        //         }
        //     }
        // }
        stage('Unit Tests') {
            steps {
                dir('student-management-backend') {
                    sh './mvnw -Dtest=StudentServiceTest verify'
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                dir('student-management-backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh './mvnw sonar:sonar -Dsonar.projectKey=student-management-backend'
                    }
                }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Docker Build & Push') {
            steps {
                dir('student-management-backend') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKERHUB_USERNAME',
                            passwordVariable: 'DOCKERHUB_TOKEN'
                        )
                    ]) {
                        sh '''
                            set +x

                            IMAGE_NAME="$DOCKERHUB_USERNAME/student-management-backend:build-${BUILD_NUMBER}"

                            echo "$DOCKERHUB_TOKEN" | docker login \
                                --username "$DOCKERHUB_USERNAME" \
                                --password-stdin

                            docker build -t "$IMAGE_NAME" .

                            docker push "$IMAGE_NAME"

                            docker logout
                        '''
                    }
                }
            }
        }
    }
}